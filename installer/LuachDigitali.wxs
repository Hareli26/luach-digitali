<!--
  MSI for Luach Digitali (WiX Toolset 5). Build with installer\build-msi.cmd.

  Per-machine install to Program Files, Start Menu + Desktop shortcuts, starts with Windows for every user,
  creates C:\ProgramData\LuachDigitali for the shared settings file.

  Public properties (for silent deployment):
    AUTOSTART=1|0         start the board when any user signs in (default 1)
    DESKTOPSHORTCUT=1|0   desktop shortcut for all users (default 1)
  Example:  msiexec /i LuachDigitali-1.0.0-x64.msi /qn AUTOSTART=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Luach Digitali" Manufacturer="Luach Digitali" Version="$(var.Version)"
           UpgradeCode="6B1F3C2E-8D4A-4E7B-9C51-2A7D0E9F4B13" Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Luach Digitali is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="Digital synagogue board (kiosk). Exit the kiosk with Ctrl+Shift+Q." />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Property Id="AUTOSTART" Value="1" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Luach Digitali" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="LuachDigitali" />
    </StandardDirectory>

    <Feature Id="Main" Title="Luach Digitali" Level="1">
      <!-- The whole packaged Electron app -->
      <Files Directory="INSTALLFOLDER" Include="$(var.AppDir)\**" />

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="3E0B7F42-6C1D-4A8E-B2F5-91D4C7A06E21">
        <Shortcut Id="StartMenuLink" Name="Luach Digitali" Description="Digital synagogue board"
                  Target="[INSTALLFOLDER]Luach Digitali.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Luach Digitali" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = 1" Guid="A47C2D19-5E83-4F06-9B1A-D2E6F30C8B54">
        <Shortcut Id="DesktopLink" Name="Luach Digitali" Description="Digital synagogue board"
                  Target="[INSTALLFOLDER]Luach Digitali.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Luach Digitali" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Start with Windows: every user who signs in on this PC gets the board -->
      <Component Id="AutoStart" Directory="INSTALLFOLDER" Condition="AUTOSTART = 1" Guid="D58E1A3B-2F7C-4B90-8E64-0C3A9F1D7B26">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="LuachDigitali"
                       Type="string" Value="&quot;[INSTALLFOLDER]Luach Digitali.exe&quot;" KeyPath="yes" />
      </Component>

      <!-- Shared settings folder: put settings.json here (a backup exported from the board) to configure every PC alike -->
      <Component Id="DataFolder" Directory="DATAFOLDER" Guid="91B6E4D2-0A3F-4C7E-8D15-6F2B9A7C3E08">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Luach Digitali" Name="SettingsFolder" Type="string" Value="[DATAFOLDER]" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Interactive install only (never in silent / SYSTEM deployments): open the board when setup finishes -->
    <CustomAction Id="LaunchBoard" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Luach Digitali.exe&quot;"
                  Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchBoard" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt;= 4" />
    </InstallExecuteSequence>
  </Package>
</Wix>
